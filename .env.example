# Copy to .env in the repo root and/or backend/ and adjust as needed.
# Never commit a real .env file.

# --- Backend (backend/app/config.py) ---
APP_NAME="Pik Nirnay"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://pik_nirnay:pik_nirnay@localhost:5432/pik_nirnay
DEFAULT_LANGUAGE=mr
SUPPORTED_LANGUAGES=["mr","en"]
CORS_ORIGINS=["http://localhost:5173"]

# --- Frontend (frontend/, injected at build time by Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
